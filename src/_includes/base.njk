<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} | {% endif %}Arrow of Light Wildlife & Pest Solutions | Utah County Pest Control</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}Professional wildlife removal and pest control services in Utah County, Utah. 25+ years experience. FREE inspections. Licensed & insured.{% endif %}">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://arrowoflightpest.com{% if page.url != '/' %}{{ page.url }}{% endif %}">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}Arrow of Light Wildlife & Pest Solutions{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}Professional wildlife removal and pest control services in Utah County, Utah. 25+ years experience.{% endif %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://arrowoflightpest.com{% if page.url != '/' %}{{ page.url }}{% endif %}">
    <meta property="og:image" content="https://arrowoflightpest.com/images/IMG_5676.jpeg">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Schema.org Organization markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": ["Organization", "LocalBusiness"],
        "name": "Arrow of Light Wildlife & Pest Solutions LLC",
        "alternateName": "Arrow of Light Pest Solutions",
        "description": "Professional wildlife removal and pest control services in Utah County, Utah",
        "url": "https://arrowoflightpest.com",
        "telephone": "(385) 590-9835",
        "email": "info@arrowoflightpest.com",
        "foundingDate": "2024",
        "founder": {
            "@type": "Person",
            "name": "TW Trent English"
        },
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Utah County",
            "addressRegion": "UT",
            "addressCountry": "US"
        },
        "areaServed": {
            "@type": "Place",
            "name": "Utah County, Utah"
        },
        "serviceType": ["Pest Control", "Wildlife Removal", "Pest Prevention"],
        "priceRange": "$$",
        "paymentAccepted": ["Cash", "Credit Card", "Check"],
        "currenciesAccepted": "USD",
        "openingHours": "Mo-Sa 08:00-18:00",
        "logo": "https://arrowoflightpest.com/images/logo.jpg",
        "image": "https://arrowoflightpest.com/images/IMG_5676.jpeg",
        "sameAs": [
            "https://www.facebook.com/arrowoflightpest",
            "https://www.instagram.com/arrowoflightpest"
        ]
    }
    </script>
    
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Pest Control Service",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Arrow of Light Wildlife & Pest Solutions LLC"
        },
        "areaServed": [
            {"@type": "City", "name": "Provo", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Orem", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Lehi", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "American Fork", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Spanish Fork", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Springville", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Payson", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Pleasant Grove", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Eagle Mountain", "containedInPlace": {"@type": "State", "name": "Utah"}},
            {"@type": "City", "name": "Saratoga Springs", "containedInPlace": {"@type": "State", "name": "Utah"}}
        ],
        "description": "Professional pest control and wildlife removal services in Utah County, Utah. 25+ years experience. Humane methods. FREE inspections.",
        "offers": {
            "@type": "Offer",
            "description": "FREE Full Home & Property Inspection",
            "price": "0",
            "priceCurrency": "USD"
        }
    }
    </script>
    
    {% if page.url == "/" %}
    <!-- FAQPage Schema for Homepage -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "Do you offer free inspections?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes! We provide completely FREE full home and property inspections. We'll identify pest entry points, nesting areas, and damage, then provide a detailed treatment plan."
                }
            },
            {
                "@type": "Question",
                "name": "Are your methods safe for pets and children?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Absolutely. We specialize in humane, eco-friendly pest control methods. All treatments are safe for your family and pets when applied according to our protocols."
                }
            },
            {
                "@type": "Question",
                "name": "How quickly can you respond to wildlife emergencies?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "We offer same-day service for emergencies. Most inspections can be scheduled within 24-48 hours. Call (385) 590-9835 for immediate assistance."
                }
            },
            {
                "@type": "Question",
                "name": "Do you service all of Utah County?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes, we serve all areas throughout Utah County, including Provo, Orem, American Fork, Lehi, Spanish Fork, and surrounding communities."
                }
            },
            {
                "@type": "Question",
                "name": "What makes you different from other pest control companies?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "25+ years of experience, 35+ TV news appearances, third-party quality assurance inspections, and humane methods. We're not door-knockers or rookies – we're seasoned professionals."
                }
            },
            {
                "@type": "Question",
                "name": "Do you offer recurring pest control programs?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes, we design customized recurring programs based on your specific pest issues and property needs. Prevention is always more cost-effective than reactive treatments."
                }
            }
        ]
    }
    </script>
    {% endif %}

    {% if page.url != "/" %}
    <!-- BreadcrumbList Schema for inner pages -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://arrowoflightpest.com"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ title }}",
                "item": "https://arrowoflightpest.com{{ page.url }}"
            }
        ]
    }
    </script>
    {% endif %}
</head>
<body>
    {% include "nav.njk" %}
    
    <main>
        {{ content | safe }}
    </main>
    
    {% include "footer.njk" %}
    
    <script src="/js/main.js"></script>
</body>
</html>