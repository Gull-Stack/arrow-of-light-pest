<!-- Contact Form -->
<section class="section section-white" id="contact-form">
    <div class="container">
        <div class="section-header">
            <span class="section-label">Schedule Inspection</span>
            <h2>Free Pest Inspection Request</h2>
            <p>Tell us about your pest problem and we'll provide a detailed assessment</p>
        </div>
        
        <div style="max-width: 600px; margin: 0 auto;">
            <form class="contact-form" action="#" method="POST">
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First Name *</label>
                        <input type="text" id="firstName" name="firstName" required>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Last Name *</label>
                        <input type="text" id="lastName" name="lastName" required>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="email">Email Address *</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input type="tel" id="phone" name="phone" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="address">Property Address</label>
                    <input type="text" id="address" name="address" placeholder="123 Main St, City, UT">
                </div>
                
                <div class="form-group">
                    <label for="pestType">What pests are you seeing? *</label>
                    <select id="pestType" name="pestType" required>
                        <option value="">Select primary pest concern</option>
                        <option value="rodents">Mice/Rats</option>
                        <option value="wildlife">Raccoons/Squirrels/Wildlife</option>
                        <option value="spiders">Spiders/Scorpions</option>
                        <option value="wasps">Wasps/Bees/Stinging Insects</option>
                        <option value="ants">Ants</option>
                        <option value="general">General Pest Control</option>
                        <option value="solar">Solar Panel Protection</option>
                        <option value="other">Other (please specify in message)</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="urgency">Timeline</label>
                    <select id="urgency" name="urgency">
                        <option value="routine">Routine (within 1-2 weeks)</option>
                        <option value="soon">Soon (within 3-5 days)</option>
                        <option value="urgent">Urgent (within 24-48 hours)</option>
                        <option value="emergency">Emergency (same day)</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="message">Tell us more about the problem</label>
                    <textarea id="message" name="message" rows="4" placeholder="Where are you seeing pests? How long has this been a problem? Any specific areas of concern?"></textarea>
                </div>
                
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="consent" required>
                        <span>I agree to receive communication from Arrow of Light Wildlife & Pest Solutions regarding my inspection request. *</span>
                    </label>
                </div>
                
                <button type="submit" class="btn btn-primary" style="width: 100%;">Schedule My Free Inspection</button>
            </form>
        </div>
    </div>
</section>

